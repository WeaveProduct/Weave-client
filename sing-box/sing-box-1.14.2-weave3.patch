+func getTotalsByOutboundType(trafficManager *trafficcontrol.Manager) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		totals := trafficManager.TotalByOutboundType()
+		result := make(render.M, len(totals))
+		for outboundType, total := range totals {
