+
+// addClosedTypeTotal must be called with closedConnectionsAccess held.
+func (m *Manager) addClosedTypeTotal(outboundType string, upload int64, download int64) {
+	if m.closedTypeTotals == nil {
+		m.closedTypeTotals = make(map[string][2]int64)
+	}
+	total := m.closedTypeTotals[outboundType]
+	total[0] += upload
+	total[1] += download
+	m.closedTypeTotals[outboundType] = total
+}
+
+// TotalByOutboundType (WeaveVPN): upload/download since start by outbound type (direct, socks, vless, ...),
+// including closed connections, so clients can tell traffic through the server from direct traffic.
+func (m *Manager) TotalByOutboundType() map[string][2]int64 {
+	totals := make(map[string][2]int64)
+	add := func(outboundType string, upload int64, download int64) {
+		total := totals[outboundType]
+		total[0] += upload
+		total[1] += download
+		totals[outboundType] = total
+	}
+	m.closedConnectionsAccess.Lock()
+	for outboundType, total := range m.closedTypeTotals {
+		add(outboundType, total[0], total[1])
+	}
+	for element := m.closedConnections.Front(); element != nil; element = element.Next() {
+		add(element.Value.OutboundType, element.Value.Upload.Load(), element.Value.Download.Load())
+	}
+	m.closedConnectionsAccess.Unlock()
+	m.connections.Range(func(_ uuid.UUID, tracker Tracker) bool {
+		metadata := tracker.Metadata()
+		add(metadata.OutboundType, metadata.Upload.Load(), metadata.Download.Load())
+		return true
+	})
+	return totals
+}
